# Live Show Radar: every environment variable, and where to get it.
# Copy to .env for local scripts (pnpm db:migrate, seed, spotify:auth, telegram:webhook).
# In production: GitHub → Settings → Secrets and variables → Actions (jobs) and Vercel →
# Project → Settings → Environment Variables (dashboard + webhook). README → "Where every
# secret goes" says which side needs which. Never commit real values.

# --- Database (Neon) ---------------------------------------------------------------------
# Neon console → your project → Connect → copy the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- LLMs --------------------------------------------------------------------------------
# Google AI Studio → Get API key (free tier).
GEMINI_API_KEY=
# Optional; a current Flash model name from ai.google.dev/gemini-api/docs/models.
GEMINI_MODEL=gemini-3.8-flash
# console.groq.com → API Keys (free tier). Used when Gemini fails or hits its quota.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional; a Groq vision model so poster images still work on the fallback.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Telegram ----------------------------------------------------------------------------
# @BotFather → /newbot. Keep this secret.
TELEGRAM_BOT_TOKEN=
# Chat IDs allowed to talk to the bot, comma separated (README → "Finding chat IDs").
TELEGRAM_ALLOWED_CHAT_IDS=
# Where alerts go (usually Karan's chat with the bot).
TELEGRAM_ALERT_CHAT_ID=
# Dry-run target: a separate chat (e.g. a private group with just you and the bot).
TELEGRAM_TEST_CHAT_ID=
# Any random string of 16–256 letters, digits, _ or -. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# "1" sends everything to TELEGRAM_TEST_CHAT_ID instead (set as a GitHub *variable* and in Vercel).
RADAR_DRY_RUN=

# --- Spotify -----------------------------------------------------------------------------
# developer.spotify.com → Dashboard → Create app (owner needs Spotify Premium).
# Redirect URI: http://127.0.0.1:8888/callback   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# From `pnpm spotify:auth`. Expires 6 months after you authorise; the radar warns you on Telegram.
SPOTIFY_REFRESH_TOKEN=

# --- Instagram Graph API (Business Discovery) ---------------------------------------------
# developers.facebook.com → your app → App settings → Basic.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Karan's Instagram creator account ID (README → Instagram, step 6).
INSTAGRAM_USER_ID=
# Long-lived user token (~60 days). The watchlist job refreshes it and stores the new one in Neon.
INSTAGRAM_ACCESS_TOKEN=
# Optional; Graph API version.
GRAPH_API_VERSION=v25.0

# --- setlist.fm and MusicBrainz -----------------------------------------------------------
# setlist.fm → sign in → API → apply for a key (free, non-commercial).
SETLISTFM_API_KEY=
# An email or URL MusicBrainz can contact you on; goes in the User-Agent their terms require.
MUSICBRAINZ_CONTACT=you@example.com

# --- Google Calendar (clash detection) ----------------------------------------------------
# Google Calendar → Settings → your calendar → "Secret address in iCal format". Optional.
GOOGLE_CALENDAR_ICS_URL=

# --- Calendar feed and email ingest ---------------------------------------------------------
# Long random strings (32+ chars). The feed URL is <PUBLIC_BASE_URL>/api/calendar/<token>.ics
CALENDAR_FEED_TOKEN=
# Shared with the Apps Script (Script properties → RADAR_INGEST_SECRET).
INGEST_EMAIL_SECRET=

# --- Dashboard sign-in (Auth.js / next-auth v4) ----------------------------------------------
# The only Google account allowed in.
ALLOWED_EMAIL=karan@example.com
# Random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# Your deployed URL, e.g. https://live-show-radar.vercel.app
NEXTAUTH_URL=
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Same as NEXTAUTH_URL; used for the Telegram webhook and links.
PUBLIC_BASE_URL=

# --- Optional ---------------------------------------------------------------------------
# Start a poll run right after a fan-app email arrives (fine-grained GitHub token with
# "Actions: read and write" on this repo only). Without it, emails are picked up within the hour.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=your-github-user/live-show-radar
# Local only: skip Google sign-in under `next dev` (ignored in production builds).
DEV_AUTH_BYPASS=
# Where job state is cached between Actions runs.
RADAR_STATE_DIR=.radar-state
